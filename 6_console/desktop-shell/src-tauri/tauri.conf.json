{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniMemora Desktop",
  "version": "1.0.0-beta.2",
  "identifier": "com.doloclaw.omnimemora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniMemora Desktop",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi"
    ],
    "category": "Productivity",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
