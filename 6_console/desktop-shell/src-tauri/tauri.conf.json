{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniMemora Desktop",
  "version": "1.0.0-beta.11",
  "identifier": "com.doloclaw.omnimemora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniMemora Desktop",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "msi"
    ],
    "category": "Productivity",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREQjA0MkJCNEYwOEM4OTIKUldTU3lBaFB1MEt3M2FTeGQ2TDViem8yTUZkYnRVeS90eXQ2Z1EwM1dKaVUrSkVzUEJiMXh5Q2gK",
      "endpoints": [
        "https://doloclaw.com/releases/desktop-updater/{{target}}-{{arch}}.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
