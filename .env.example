# OmniMemora root environment template
# Copy to .env and adjust values for your machine.

# Adapter HTTP port
PORT=18011
OMNIMEMORA_ADAPTER_HOST=127.0.0.1
OMNIMEMORA_ADAPTER_PORT=18011
OMNIMEMORA_ADAPTER_URL=http://127.0.0.1:18011

# Backend selection
MEMORY_BACKEND_TYPE=omnimemora_runtime
MEMORY_BACKEND_URL=http://127.0.0.1:8765

# Runtime local service (optional overrides)
# OMNIMEMORA_CONFIG=/absolute/path/to/config.json
# OMNIMEMORA_RUNTIME_DATA_DIR=/absolute/path/to/omnimemora/data
# OMNIMEMORA_DATA_DIR=/absolute/path/to/omnimemora/data
# OMNIMEMORA_RUNTIME_LOG_DIR=/absolute/path/to/omnimemora/logs
# OMNIMEMORA_LOG_DIR=/absolute/path/to/omnimemora/logs
# OMNIMEMORA_RUNTIME_ENDPOINT=127.0.0.1
# OMNIMEMORA_RUNTIME_DB_TYPE=sqlite
# OMNIMEMORA_RUNTIME_LOG_LEVEL=info

# Optional backend timeouts
MEMORY_BACKEND_TIMEOUT_SECONDS=30
MEMORY_BACKEND_CONNECT_TIMEOUT_SECONDS=5

# Optional logging
LOG_LEVEL=INFO

# Optional tokens (leave empty for local dev unless needed)
OMNIMEMORA_INTERNAL_API_TOKEN=
OMNIMEMORA_ADMIN_API_TOKEN=

# Optional external data dirs (recommended for migration / prod-like local runs)
# OMNIMEMORA_METER_DATA_DIR=/absolute/path/to/omnimemora/meter
