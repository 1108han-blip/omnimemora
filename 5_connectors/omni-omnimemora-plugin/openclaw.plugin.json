{
  "id": "omnimemora-memory",
  "kind": "memory",
  "uiHints": {
    "baseUrl": {
      "label": "OmniMemora Gateway Base URL",
      "placeholder": "http://127.0.0.1:18011",
      "help": "OmniMemora Gateway URL (default: http://127.0.0.1:18011)"
    },
    "agentId": {
      "label": "Agent ID",
      "placeholder": "supervisor",
      "help": "Identifies this agent to OmniMemora. Default: supervisor."
    },
    "timeoutMs": {
      "label": "Request Timeout (ms)",
      "placeholder": "30000",
      "advanced": true
    },
    "autoCapture": {
      "label": "Auto-Capture",
      "help": "Extract memories from recent conversation messages via OmniMemora"
    },
    "captureMaxLength": {
      "label": "Capture Max Length",
      "placeholder": "24000",
      "advanced": true,
      "help": "Maximum sanitized user text length allowed for auto-capture"
    },
    "autoRecall": {
      "label": "Auto-Recall",
      "help": "Inject relevant OmniMemora memories into agent context"
    },
    "recallLimit": {
      "label": "Recall Limit",
      "placeholder": "6",
      "advanced": true
    },
    "recallScoreThreshold": {
      "label": "Recall Score Threshold",
      "placeholder": "0.01",
      "advanced": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string"
      },
      "agentId": {
        "type": "string"
      },
      "timeoutMs": {
        "type": "number"
      },
      "autoCapture": {
        "type": "boolean"
      },
      "captureMaxLength": {
        "type": "number"
      },
      "autoRecall": {
        "type": "boolean"
      },
      "recallLimit": {
        "type": "number"
      },
      "recallScoreThreshold": {
        "type": "number"
      }
    }
  }
}
