# =============================================
# OmniMemora Adapter — Environment Variables
# =============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- OpenViking (required) ---
VIKING_URL=http://openviking-server:1933
VIKING_API_KEY=your_viking_api_key_here

# --- Internal Service Token (must match Cloudflare INTERNAL_ADAPTER_TOKEN) ---
OMNIMEMORA_INTERNAL_API_TOKEN=generate_a_64_char_hex_token

# --- Admin Token (for /api/admin/* endpoints) ---
OMNIMEMORA_ADMIN_API_TOKEN=generate_a_strong_random_token

# --- Registry Sync from Cloudflare D1 ---
OMNIMEMORA_REGISTRY_SYNC_ENABLED=true
OMNIMEMORA_REGISTRY_SYNC_URL=https://doloclaw.com/api/tenants
OMNIMEMORA_REGISTRY_SYNC_TOKEN=same_as_in_cloudflare_settings
OMNIMEMORA_REGISTRY_SYNC_TIMEOUT=30

# --- Trial Defaults ---
OMNIMEMORA_TRIAL_DAYS=14
OMNIMEMORA_TRIAL_QUOTA_TOKENS=500000

# --- Memory Namespace ---
VIKING_MEMORY_NAMESPACE_ROOT=viking://resources/memory-adapter

# --- Timeouts ---
VIKING_CONNECT_TIMEOUT_SECONDS=5
VIKING_HEALTH_TIMEOUT_SECONDS=5
VIKING_SEARCH_TIMEOUT_SECONDS=20
VIKING_READ_TIMEOUT_SECONDS=20
VIKING_DELETE_TIMEOUT_SECONDS=20
VIKING_SNAPSHOT_TIMEOUT_SECONDS=60
VIKING_UPLOAD_TIMEOUT_SECONDS=20
VIKING_COMMIT_TIMEOUT_SECONDS=45
VIKING_RESOLVE_TIMEOUT_SECONDS=15
VIKING_RETRY_ATTEMPTS=1
VIKING_RETRY_BACKOFF_SECONDS=0.75

# --- Logging ---
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=5000
